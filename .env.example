PORT=8787
DB_PATH=./data/farm.db
KEY_SECRET=              # openssl rand -hex 32
JWT_SECRET=              # openssl rand -hex 24
TREASURY=0x              # 收 USDC 服务费的 HyperEVM 地址
FEE_BPS=0                # 0 = 免费模式；300 = 服务费 净已实现亏损 × 3%
FEE_MIN_USDC=1           # 每次预付最低
MARKETS=BTC,ETH
CORS_ORIGIN=*
TG_TOKEN=                # Telegram bot token（可选）
TG_CHAT=                 # 你的 Telegram 用户 id（可选）
MIN_BUST_PCT=0.006       # 杠杆安全上限：强平距离至少 0.6%（≈150x）
